rules_version = '2';
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 그대로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 관리자 목록: 콘솔에서만 추가. 본인 문서만 읽기 가능(로그인 시 관리자 확인용)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 실험실 사용 신청 원본 (학생 이름·학번 포함)
    //  - 누구나 '검토 중' 상태로만 새 신청 가능
    //  - 읽기·승인/반려는 관리자만 (학생은 statusBoard에서 팀명으로 결과 확인)
    match /labRequests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.keys().hasOnly(['year','team','date','start','end','lab','purpose','teacher','users',
             'materials','reagents','plan','agree','applyDate','status','adminNote','createdAt','sign'])
        && request.resource.data.team.size() < 60
        && request.resource.data.purpose.size() < 300
        && request.resource.data.reagents.size() <= 20
        && signOk(request.resource.data);
    }

    // 서명 이미지(신청자·지도교사): 크기 제한 (각 100KB 미만)
    function signOk(d) {
      return !('sign' in d) || (d.sign.keys().hasOnly(['applicant','teacher'])
        && d.sign.get('applicant', '').size() < 100000
        && d.sign.get('teacher', '').size() < 100000);
    }

    // 물품 구입 신청 원본: 실험실 신청과 같은 방식
    match /purchaseRequests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.keys().hasOnly(['year','purpose','sid','name','useDate','teacher','team',
             'items','status','adminNote','createdAt','sign'])
        && request.resource.data.team.size() < 60
        && request.resource.data.items.size() <= 40
        && signOk(request.resource.data);
    }

    // 신청 결과 요약 (팀명·일시·상태·메모만, 이름·학번 없음): 누구나 팀명으로 조회
    //  - 신청서와 같은 묶음으로만 새로 만들 수 있음 (가짜 결과 방지)
    match /statusBoard/{id} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.keys().hasOnly(['kind','year','team','teamKey','status','adminNote','createdAt',
             'date','start','end','lab','useDate','itemCount','total'])
        && (existsAfter(/databases/$(database)/documents/labRequests/$(id))
            || existsAfter(/databases/$(database)/documents/purchaseRequests/$(id))));
    }

    // 캘린더 일정: 누구나 보기, 관리자만 수정
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 이수시간 (문서ID = 학년도_학번): 단건 조회만 공개, 전체 목록·입력·삭제는 관리자만
    match /hours/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ===== 디벗 =====
    // 기기대장 (학생 이름·시리얼·계정): 관리자만
    match /devices/{id} {
      allow read, write: if isAdmin();
    }

    function sidOk(d) {
      return d.sid is string && d.sid.matches('^[1-3][0-9]{4}$');
    }

    // 구글 비밀번호 재설정 요청: 누구나 '검토 중'으로만 신청, 읽기·처리는 관리자만 (비밀번호는 저장하지 않음)
    match /pwRequests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['sid','name','reason','status','adminNote','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && sidOk(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() < 20
        && request.resource.data.reason is string && request.resource.data.reason.size() < 200;
    }

    // 앱·사이트 허용 신청
    match /appRequests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['sid','name','kind','title','url','purpose','key','status','adminNote','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && sidOk(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() < 20
        && request.resource.data.kind in ['app','site']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.purpose is string && request.resource.data.purpose.size() <= 200
        && request.resource.data.key is string && request.resource.data.key.size() <= 60;
    }

    // 디벗 신청 결과 요약 (제목·상태·메모 + 이름·PIN을 해시로 바꾼 조회 열쇠만, 이름·학번·PIN 없음)
    match /dibutStatus/{id} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['kind','lookup','title','status','note','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.note == ''
        && request.resource.data.lookup is string && request.resource.data.lookup.matches('^[0-9a-f]{64}$')
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && ((request.resource.data.kind == 'pw' && existsAfter(/databases/$(database)/documents/pwRequests/$(id)))
            || (request.resource.data.kind == 'app' && existsAfter(/databases/$(database)/documents/appRequests/$(id)))));
    }
  }
}
