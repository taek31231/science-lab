rules_version = '2';
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 그대로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 관리자 목록: 콘솔에서만 추가. 본인 문서만 읽기 가능(로그인 시 관리자 확인용)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 실험실 사용 신청
    //  - 누구나 '검토 중' 상태로만 새 신청 가능
    //  - 접수번호(문서ID)를 아는 사람만 단건 조회 가능 (목록 조회 불가 → 다른 학생 이름 노출 X)
    //  - 목록 조회·승인/반려는 관리자만
    match /labRequests/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.keys().hasOnly(['date','start','end','lab','purpose','teacher','users',
             'materials','reagents','plan','agree','applyDate','status','adminNote','createdAt'])
        && request.resource.data.purpose.size() < 300
        && request.resource.data.reagents.size() <= 20;
    }

    // 물품 구입 신청: 실험실 신청과 같은 방식
    match /purchaseRequests/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.keys().hasOnly(['purpose','sid','name','useDate','teacher','team',
             'items','status','adminNote','createdAt'])
        && request.resource.data.items.size() <= 40;
    }

    // 캘린더 일정: 누구나 보기, 관리자만 수정
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 이수시간: 학번으로 단건 조회만 공개, 전체 목록·입력은 관리자만
    match /hours/{sid} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}
